---
import "../styles/app.css";

interface Props {
  title?: string;
}
const { title = "IRDR | ANALISES" } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Análise da contagem oficial de inventário (IRDR): DPMO, erros por processo, ofensores, STU e plano de ação." />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f6fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0e17" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <!-- Aplica o tema salvo antes da primeira pintura (evita piscar claro/escuro) -->
    <script is:inline>
      try {
        const t = localStorage.getItem("irdr-theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
